# Nagma server settings for docker compose (docker-compose.yml reads .env).
# Copy to .env and uncomment what you need; everything is optional. Leave a setting commented out
# rather than empty: an empty value counts as set (an empty TRASH_DAYS would empty the trash at once).
# tools/install.sh writes this file for you. Full guide: docs/self-hosting.md.
# Settings named MIGFA_* (the product's old name) still work and are read as NAGMA_*, with a
# deprecation line in the log; rename them when you can.

# ---- Address and HTTPS ----

# Your server's domain (DNS A/AAAA record pointing here). With COMPOSE_PROFILES=https, Caddy gets a
# certificate for it automatically and serves Nagma on https://NAGMA_DOMAIN.
NAGMA_DOMAIN=
# Set to "https" to start the Caddy service (needs NAGMA_DOMAIN); leave empty to serve plain HTTP.
COMPOSE_PROFILES=
# The address people reach the server at, used in emailed links and share links (https://nagma.example.com).
# NAGMA_PUBLIC_URL=
# Where the editor lives when it isn't served by this server (single sign-on returns there). Usually empty.
# NAGMA_APP_URL=
# The name the apps' server picker shows for this server (default "Nagma").
NAGMA_SERVER_NAME=Nagma
# Host interface and port the container is published on (127.0.0.1 behind Caddy, 0.0.0.0 without it).
NAGMA_BIND=0.0.0.0
NAGMA_HTTP_PORT=8080
# Trust the X-Forwarded-For header from a reverse proxy (Caddy, Cloudflare) for rate limits. 1 behind a proxy.
# TRUST_PROXY=

# ---- Inside the container (set by docker-compose.yml; change only when running server.mjs yourself) ----

# Port the server listens on.
# PORT=8080
# Folder for files, accounts and uploads (the nagma-data volume).
# DATA_DIR=/data
# Folder with the built editor the server serves.
# STATIC_DIR=/app/web/dist

# ---- Accounts ----

# Comma-separated emails of the server admins. Unset, the first account made on the server is the admin.
# NAGMA_ADMINS=
# 1 holds back sharing and publishing until an account verifies its email, 0 never does. Unset: required when mail is set up.
# NAGMA_REQUIRE_VERIFIED_EMAIL=
# Sign-ups allowed per client address per hour (default 10).
# NAGMA_SIGNUP_PER_HOUR=
# Days a session may go unused before it ends (default 30).
# SESSION_IDLE_DAYS=

# ---- Mail (verification links, password resets, invitations, digests) ----

# SMTP server: smtp://user:pass@host:587 (STARTTLS) or smtps://user:pass@host:465 (TLS). Empty: no mail.
# NAGMA_SMTP_URL=
# Sender address for mail (default: the SMTP user name when it's an address).
# NAGMA_MAIL_FROM=
# Minutes between email digests of unread mentions and replies (default 30).
# DIGEST_MINUTES=
# Development only: 1 writes links that couldn't be mailed to files in the data folder.
# NAGMA_DEV_MAIL_FILE=

# ---- Single sign-on (OpenID Connect; SAML is set up per team in the admin console) ----

# Your identity provider's issuer URL, and this server's client there.
# NAGMA_OIDC_ISSUER=
# NAGMA_OIDC_CLIENT_ID=
# NAGMA_OIDC_CLIENT_SECRET=
# The button's name in the sign-in dialog (default "Single sign-on").
# NAGMA_OIDC_NAME=
# Email domains that sign in through it (comma separated).
# NAGMA_OIDC_DOMAINS=

# ---- Sites ----

# Domain whose subdomains serve published sites (<name>.NAGMA_SITES_DOMAIN; needs a wildcard DNS record
# and certificate). Sites are always at https://NAGMA_DOMAIN/s/<name>/ too. Default "localhost".
# NAGMA_SITES_DOMAIN=
# The CNAME target custom site domains are told to point at (default sites.<this server's host>).
# NAGMA_SITES_CNAME=

# ---- Calls and screen sharing ----

# STUN/TURN servers for calls across networks, as JSON: [{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
# NAGMA_ICE_SERVERS=

# ---- AI (optional; people can also bring their own keys in their account settings) ----

# Server-wide fallback key for AI features when someone hasn't added their own; NAGMA_SHARED_AI=0 turns it off.
# ANTHROPIC_API_KEY=
# NAGMA_SHARED_AI=1
# Secret that encrypts the AI keys people save. Unset, one is written to DATA_DIR/secret-key on first run (back it up).
# NAGMA_SECRET_KEY=
# AI requests per person per minute (30).
# NAGMA_AI_PER_MINUTE=30
# Another API address compatible with the same API (a gateway or proxy).
# ANTHROPIC_BASE_URL=
# Model for the editor's AI features, and for Make (app generation); Make's model list and effort.
# ANTHROPIC_MODEL=
# ANTHROPIC_MAKE_MODEL=
# ANTHROPIC_MAKE_MODELS=
# ANTHROPIC_MAKE_EFFORT=
# Image generation: an images endpoint that takes {prompt, n, size}, its key, and an optional model.
# NAGMA_IMAGE_API_URL=
# NAGMA_IMAGE_API_KEY=
# NAGMA_IMAGE_MODEL=

# ---- Other integrations ----

# Stock photos: a key, and the provider (unsplash or pexels).
# NAGMA_STOCK_KEY=
# NAGMA_STOCK_PROVIDER=
# GIF search: a key, and the provider (giphy or tenor).
# NAGMA_GIF_KEY=
# NAGMA_GIF_PROVIDER=
# Token for code connect and Make's GitHub export (GITHUB_TOKEN works too), and the API address for GitHub Enterprise.
# NAGMA_GITHUB_TOKEN=
# GITHUB_API_URL=

# ---- Housekeeping ----

# Days files stay in the trash before they're removed (default 30).
# TRASH_DAYS=
# Milliseconds between automatic versions of a file being edited (default 1800000, half an hour).
# AUTO_VERSION_MS=
# The version /health reports (default: the server package's).
# NAGMA_VERSION=

# ---- Desktop app builds (read when building apps/desktop, not by the server) ----

# The desktop builds update from the project's GitHub Releases. NAGMA_UPDATE_URL points them at a
# folder of your own instead (with its update channel, latest or beta); NAGMA_NO_UPDATES=1 makes builds
# that never update themselves. See docs/releasing.md.
# NAGMA_UPDATE_URL=
# NAGMA_UPDATE_CHANNEL=
# NAGMA_NO_UPDATES=
