{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nagma-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "apps/web",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "nagma-5210",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "apps/web",
        "--",
        "--port",
        "5210",
        "--strictPort"
      ],
      "port": 5210
    },
    {
      "name": "landing",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5391",
        "--bind",
        "127.0.0.1",
        "--directory",
        "apps/landing"
      ],
      "port": 5391
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5392",
        "--bind",
        "127.0.0.1",
        "--directory",
        "apps/landing/dist"
      ],
      "port": 5392
    }
  ]
}
